# Copie ce fichier en .env et remplis les valeurs que tu obtiens.
# Ne commite jamais le fichier .env réel dans Git.

# --- Option B : API Entreprise - liens capitalistiques (DGFIP) ---
# Jeton JWT obtenu après habilitation sur https://datapass.api.gouv.fr/demandes/api-entreprise/nouveau
# ATTENTION : cette API est réservée aux administrations / organismes exerçant
# une mission de service public. Un particulier ou une société privée n'est
# en général PAS éligible. Voir le README, section "Clés API nécessaires".
API_ENTREPRISE_TOKEN=

# Paramètres de traçabilité obligatoires sur CHAQUE appel API Entreprise
# (voir https://entreprise.api.gouv.fr/developpeurs#renseigner-les-parametres-dappel-et-de-tracabilite)
API_ENTREPRISE_CONTEXT=Cartographie capitalistique Eurazeo
API_ENTREPRISE_OBJECT=Analyse des participations Eurazeo
# recipient = SIRET de L'ORGANISME PUBLIC habilité (pas le tien si tu es un particulier/société privée)
API_ENTREPRISE_RECIPIENT=

# --- Option A : Data INPI / Registre National des Entreprises (RNE) ---
# Compte gratuit à créer sur https://data.inpi.fr (bouton "Se connecter" / "Créer un compte")
INPI_USERNAME=
INPI_PASSWORD=

# --- Enrichissement optionnel : API Sirene INSEE (si recherche-entreprises ne suffit pas) ---
# Compte gratuit sur https://portail-api.insee.fr -> créer une "application" -> clé d'intégration
INSEE_API_KEY=

# --- Paramètres d'exécution ---
SIREN_DEPART=692030992
ANNEES_A_TESTER=2024,2023,2022,2021,2020
PROFONDEUR_MAX=5
